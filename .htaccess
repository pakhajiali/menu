# ============================================
# CACHE CONTROL FOR GITHUB PAGES
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Default: 1 year (images, fonts, etc.)
    ExpiresDefault "access plus 1 year"

    # HTML: 1 hour (so menu updates show quickly)
    ExpiresByType text/html "access plus 1 hour"

    # CSS & JS: 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Images: 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # PDFs: 1 year
    ExpiresByType application/pdf "access plus 1 year"

    # JSON (reviews.json): 1 day (so rating updates propagate)
    ExpiresByType application/json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    # Enable caching for all files
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|pdf|woff|woff2|ttf|eot|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML: short cache
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # JSON: 1 day
    <FilesMatch "\.json$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# Enable Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/font-woff2
</IfModule>
